{
  // Transora Cloud — optional shared translation cache + usage sync.
  // Setup:
  //   npx wrangler kv namespace create transora-cache   → paste the id below
  //   npx wrangler secret put AUTH_TOKENS   (one or more random tokens, comma-separated)
  //   npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transora-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // PRIVACY.md is bundled as text and served at /privacy.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "<paste the id from: npx wrangler kv namespace create transora-cache>" }
  ],
  // Per-token request limit (and per-IP limit on failed auth). Period must be 10 or 60 seconds.
  // namespace_id is any positive integer string, unique per rate limiter in your account.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    // Comma-separated browser origins allowed to call the worker. "chrome-extension://*" allows any
    // extension (the bearer token is still required). To pin to your install, use
    // "chrome-extension://<your-extension-id>". Requests without an Origin header are unaffected.
    "ALLOWED_ORIGINS": "chrome-extension://*"
  }
}
